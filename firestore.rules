rules_version = '2';
// Sicherheitsregeln für Brainclash (Cloud Firestore)
// In der Firebase-Konsole unter Firestore → Regeln komplett einfügen und veröffentlichen.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // Spielerprofile: alle Spieler dürfen lesen, jeder schreibt nur sein eigenes
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid);
    }

    // Wer ist online: jeder schreibt nur seinen eigenen Eintrag
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid);
    }

    // Duelle: nur die beiden Spieler dürfen anlegen, ändern und löschen
    match /duels/{duelId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid in request.resource.data.players;
      allow update, delete: if signedIn() && request.auth.uid in resource.data.players;
    }

    // Chat innerhalb eines Duells
    match /duelchat/{duelId}/msgs/{msgId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid;
      allow delete: if signedIn();
    }

    // Live-Duelle (Echtzeit)
    match /live/{liveId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid in request.resource.data.players;
      allow update: if signedIn() && (request.auth.uid in resource.data.players
                    || (resource.data.status == 'waiting' && request.auth.uid in request.resource.data.players));
      allow delete: if signedIn() && request.auth.uid in resource.data.players;
      match /ans/{uid} {
        allow read: if signedIn();
        allow write: if isMe(uid);
      }
    }

    // Party-Modus (bis zu 8 Spieler)
    match /party/{partyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.host == request.auth.uid;
      allow update, delete: if signedIn() && request.auth.uid in resource.data.players;
      match /ans/{uid} {
        allow read: if signedIn();
        allow write: if isMe(uid);
      }
    }

    // ---- SPIELE-HUB (seit 22.11.2026, Würfelclash) ----
    // Spielstand je Spiel und Spieler: jeder schreibt nur seinen eigenen.
    match /spielstand/{spiel}/spieler/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid);
    }
    // Live-Partien aller Hub-Spiele (partien/<spiel>/liste/<id>).
    // Anlegen: nur wer selbst Gastgeber und Mitspieler ist.
    // Ändern: nur Mitspieler – oder wer einer wartenden Partie mit einem
    // Spieler beitritt. Löschen: nur Mitspieler.
    match /partien/{spiel}/liste/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.host == request.auth.uid
                    && request.auth.uid in request.resource.data.players;
      // Beitreten: Würfelclash-Duell ('warten', 1 Spieler) oder Kritzelclash-Raum ('lobby', bis 8).
      allow update: if signedIn() && (request.auth.uid in resource.data.players
                    || (resource.data.status == 'warten' && resource.data.players.size() == 1
                        && request.auth.uid in request.resource.data.players)
                    || (resource.data.status == 'lobby' && resource.data.players.size() < 8
                        && request.auth.uid in request.resource.data.players));
      allow delete: if signedIn() && request.auth.uid in resource.data.players;
      // Zeichenstriche (Kritzelclash): lesen alle, schreiben/löschen nur Mitspieler.
      match /zuege/{zug}/striche/{strich} {
        allow read: if signedIn();
        allow create, delete: if signedIn()
                      && request.auth.uid in get(/databases/$(database)/documents/partien/$(spiel)/liste/$(id)).data.players;
      }
      // Chat einer Partie: nur Mitspieler schreiben, und nur unter eigenem Namen.
      // Nachrichten werden nie gelöscht (keine delete-Regel).
      match /chat/{msg} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.by == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/partien/$(spiel)/liste/$(id)).data.players;
      }
    }

    // Lobby-Chat
    match /lobby/{msgId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.by == request.auth.uid
                    && request.resource.data.size() <= 4;
      allow delete: if signedIn();
    }
  }
}
